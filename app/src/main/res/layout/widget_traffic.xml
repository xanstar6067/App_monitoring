<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_period_label"
            style="@style/WidgetLabel"
            android:text="@string/widget_today_total_label" />

        <TextView
            android:id="@+id/widget_today_total"
            style="@style/WidgetValue"
            android:layout_width="match_parent"
            android:text="2,74 ГБ"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/widget_mobile_used"
            style="@style/WidgetMeta"
            android:layout_width="match_parent"
            android:layout_marginTop="1dp"
            android:text="Моб. 1–12: 8,4 ГБ" />

        <TextView
            android:id="@+id/widget_remaining"
            style="@style/WidgetMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Ост. моб.: 1,6 ГБ"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.55"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/widget_app_1"
            style="@style/WidgetAppSlot"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:id="@+id/widget_app_1_icon"
                style="@style/WidgetAppIcon"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_app_1_usage"
                style="@style/WidgetAppUsage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_2"
            style="@style/WidgetAppSlot"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:id="@+id/widget_app_2_icon"
                style="@style/WidgetAppIcon"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_app_2_usage"
                style="@style/WidgetAppUsage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_3"
            style="@style/WidgetAppSlot"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:id="@+id/widget_app_3_icon"
                style="@style/WidgetAppIcon"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_app_3_usage"
                style="@style/WidgetAppUsage" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_4"
            style="@style/WidgetAppSlot"
            tools:ignore="UseCompoundDrawables">
            <ImageView
                android:id="@+id/widget_app_4_icon"
                style="@style/WidgetAppIcon"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_app_4_usage"
                style="@style/WidgetAppUsage" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/widget_refresh_background"
        android:contentDescription="@string/widget_refresh"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_refresh"
        android:tint="@color/widget_accent" />
</LinearLayout>
