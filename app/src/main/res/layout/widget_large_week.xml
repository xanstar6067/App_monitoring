<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:paddingEnd="30dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/WidgetLabel"
                    android:text="@string/widget_today_total_label" />
                <TextView
                    android:id="@+id/large_week_today_total"
                    style="@style/WidgetValue"
                    android:text="2,74 ГБ"
                    android:textSize="20sp" />
                <TextView
                    android:id="@+id/large_week_today_split"
                    style="@style/WidgetMeta"
                    android:text="Моб. 620 МБ · Wi‑Fi 2,12 ГБ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/large_week_period_label"
                    style="@style/WidgetLabel"
                    android:layout_gravity="end"
                    android:text="1–12 ИЮНЯ" />
                <TextView
                    android:id="@+id/large_week_period_total"
                    style="@style/WidgetValue"
                    android:layout_gravity="end"
                    android:text="18,2 ГБ"
                    android:textColor="@color/widget_blue"
                    android:textSize="18sp" />
                <TextView
                    android:id="@+id/large_week_mobile_balance"
                    style="@style/WidgetMeta"
                    android:layout_gravity="end"
                    android:text="Моб. 8,4 ГБ · осталось 1,6 ГБ"
                    android:textColor="@color/widget_accent" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/large_week_chart"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="3dp"
            android:contentDescription="@string/widget_week_chart"
            android:scaleType="fitXY" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/widget_divider_horizontal"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/widget_large_app_1"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_large_app_1_icon" style="@style/WidgetLargeAppIcon" />
            <TextView android:id="@+id/widget_large_app_1_name" style="@style/WidgetLargeAppName" android:text="Instagram" />
            <TextView android:id="@+id/widget_large_app_1_total" style="@style/WidgetLargeAppTotal" android:text="992 МБ" />
            <TextView android:id="@+id/widget_large_app_1_received" style="@style/WidgetLargeAppTransfer" android:text="↓ 820 МБ" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/widget_large_app_1_sent" style="@style/WidgetLargeAppTransfer" android:text="↑ 172 МБ" android:textColor="@color/widget_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_large_app_2"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_large_app_2_icon" style="@style/WidgetLargeAppIcon" />
            <TextView android:id="@+id/widget_large_app_2_name" style="@style/WidgetLargeAppName" android:text="Telegram" />
            <TextView android:id="@+id/widget_large_app_2_total" style="@style/WidgetLargeAppTotal" android:text="421 МБ" />
            <TextView android:id="@+id/widget_large_app_2_received" style="@style/WidgetLargeAppTransfer" android:text="↓ 350 МБ" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/widget_large_app_2_sent" style="@style/WidgetLargeAppTransfer" android:text="↑ 71 МБ" android:textColor="@color/widget_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_large_app_3"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView android:id="@+id/widget_large_app_3_icon" style="@style/WidgetLargeAppIcon" />
            <TextView android:id="@+id/widget_large_app_3_name" style="@style/WidgetLargeAppName" android:text="Монитор" />
            <TextView android:id="@+id/widget_large_app_3_total" style="@style/WidgetLargeAppTotal" android:text="253 МБ" />
            <TextView android:id="@+id/widget_large_app_3_received" style="@style/WidgetLargeAppTransfer" android:text="↓ 210 МБ" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/widget_large_app_3_sent" style="@style/WidgetLargeAppTransfer" android:text="↑ 43 МБ" android:textColor="@color/widget_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_large_app_4"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_large_app_4_icon" style="@style/WidgetLargeAppIcon" />
            <TextView android:id="@+id/widget_large_app_4_name" style="@style/WidgetLargeAppName" android:text="Google Play" />
            <TextView android:id="@+id/widget_large_app_4_total" style="@style/WidgetLargeAppTotal" android:text="210 МБ" />
            <TextView android:id="@+id/widget_large_app_4_received" style="@style/WidgetLargeAppTransfer" android:text="↓ 180 МБ" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/widget_large_app_4_sent" style="@style/WidgetLargeAppTransfer" android:text="↑ 30 МБ" android:textColor="@color/widget_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_large_app_5"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_large_app_5_icon" style="@style/WidgetLargeAppIcon" />
            <TextView android:id="@+id/widget_large_app_5_name" style="@style/WidgetLargeAppName" android:text="Chrome" />
            <TextView android:id="@+id/widget_large_app_5_total" style="@style/WidgetLargeAppTotal" android:text="164 МБ" />
            <TextView android:id="@+id/widget_large_app_5_received" style="@style/WidgetLargeAppTransfer" android:text="↓ 136 МБ" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/widget_large_app_5_sent" style="@style/WidgetLargeAppTransfer" android:text="↑ 28 МБ" android:textColor="@color/widget_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_large_app_6"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_large_app_6_icon" style="@style/WidgetLargeAppIcon" />
            <TextView android:id="@+id/widget_large_app_6_name" style="@style/WidgetLargeAppName" android:text="Speedtest" />
            <TextView android:id="@+id/widget_large_app_6_total" style="@style/WidgetLargeAppTotal" android:text="118 МБ" />
            <TextView android:id="@+id/widget_large_app_6_received" style="@style/WidgetLargeAppTransfer" android:text="↓ 96 МБ" android:textColor="@color/widget_accent" />
            <TextView android:id="@+id/widget_large_app_6_sent" style="@style/WidgetLargeAppTransfer" android:text="↑ 22 МБ" android:textColor="@color/widget_blue" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_refresh"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_refresh_background"
        android:contentDescription="@string/widget_refresh"
        android:padding="7dp"
        android:src="@drawable/ic_widget_refresh"
        android:tint="@color/widget_accent" />
</FrameLayout>
