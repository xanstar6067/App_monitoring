<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingEnd="22dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/WidgetLabel"
                    android:text="@string/widget_today" />
                <TextView
                    android:id="@+id/compact_summary_today"
                    style="@style/WidgetValue"
                    android:text="2,74 ГБ"
                    android:textColor="@color/widget_accent"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="9dp"
                android:background="@drawable/widget_divider_vertical"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/compact_summary_period_label"
                    style="@style/WidgetLabel"
                    android:text="1–12 ИЮНЯ" />
                <TextView
                    android:id="@+id/compact_summary_period"
                    style="@style/WidgetValue"
                    android:text="18,2 ГБ"
                    android:textColor="@color/widget_blue"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/compact_summary_mobile"
            style="@style/WidgetMeta"
            android:text="Мобильный: 8,4 ГБ · осталось 1,6 ГБ"
            android:textColor="@color/widget_accent" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_refresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_refresh_background"
        android:contentDescription="@string/widget_refresh"
        android:padding="6dp"
        android:src="@drawable/ic_widget_refresh"
        android:tint="@color/widget_accent" />
</FrameLayout>
