<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="12dp"
    android:paddingTop="7dp"
    android:paddingEnd="8dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/WidgetLabel"
                    android:text="↓ ЗАГРУЗКА" />
                <TextView
                    android:id="@+id/compact_speed_download"
                    style="@style/WidgetValue"
                    android:text="3,2 МБ/с"
                    android:textColor="@color/widget_accent"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="29dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/widget_divider_vertical"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/WidgetLabel"
                    android:text="↑ ОТДАЧА" />
                <TextView
                    android:id="@+id/compact_speed_upload"
                    style="@style/WidgetValue"
                    android:text="0,8 МБ/с"
                    android:textColor="@color/widget_blue"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/compact_speed_status"
            style="@style/WidgetMeta"
            android:layout_marginTop="1dp"
            android:text="Скорость сейчас"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/compact_speed_total"
            style="@style/WidgetMeta"
            android:layout_marginTop="1dp"
            android:text="Сегодня 2,7 ГБ · моб. 8,4 ГБ · ост. 1,6 ГБ" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_refresh"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_refresh_background"
        android:contentDescription="@string/widget_refresh"
        android:padding="6dp"
        android:src="@drawable/ic_widget_refresh"
        android:tint="@color/widget_accent" />
</FrameLayout>
